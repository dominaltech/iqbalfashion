# IQBAL FASHION ADMIN PORTAL — ENVIRONMENT VARIABLES TEMPLATE
# Add these in Vercel Project Settings -> Environment Variables (Admin Project)
# Leave values empty here; never commit real secrets or .env files to Git.

# 1. SUPABASE DATABASE & AUTH (Public to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. WEB PUSH NOTIFICATIONS (VAPID PUBLIC KEY FOR ADMIN BROWSER SUBSCRIPTION)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
