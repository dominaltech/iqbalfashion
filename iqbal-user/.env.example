# IQBAL FASHION USER PORTAL — ENVIRONMENT VARIABLES TEMPLATE
# Add these in Vercel Project Settings -> Environment Variables (User Project)
# Leave secrets empty here; never commit real secrets or .env files to Git.

# 1. SUPABASE DATABASE & AUTH (Public to client & server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. SUPABASE SERVICE ROLE KEY (SERVER-ONLY SECRET — NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=

# 3. CASHFREE PAYMENT GATEWAY (SERVER-ONLY SECRETS)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=PRODUCTION

# 4. WEB PUSH NOTIFICATIONS (VAPID KEYS)
# VAPID Subject URI (e.g. mailto:iqbalfashiongents@gmail.com)
VAPID_SUBJECT=
# VAPID Public Key (Safe for client)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID Private Key (SERVER-ONLY SECRET)
VAPID_PRIVATE_KEY=

# 5. DOMAIN & ORIGIN SETTINGS (Optional override for callback origin)
SITE_URL=
